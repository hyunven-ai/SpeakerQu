{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    },
    "backend": {
      "root": "backend",
      "entrypoint": "src/index.js"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)?",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/assets/(.*)",
      "destination": {
        "type": "service",
        "service": "frontend"
      }
    },
    {
      "source": "/favicon.svg",
      "destination": {
        "type": "service",
        "service": "frontend"
      }
    },
    {
      "source": "/icons.svg",
      "destination": {
        "type": "service",
        "service": "frontend"
      }
    },
    {
      "source": "/((?!api/|assets/|favicon.svg|icons.svg).*)",
      "destination": {
        "type": "service",
        "service": "frontend",
        "path": "/index.html"
      }
    }
  ]
}
